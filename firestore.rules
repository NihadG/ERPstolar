rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user ID matches the document owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // CLAIM SE ČITA ISKLJUČIVO PREKO OVE PROVJERE.
    //
    // Direktan pristup nepostojećem ključu mape (`request.auth.token.orgId` kad
    // claim nije postavljen) NIJE siguran izraz: umjesto `null` završi kao GREŠKA
    // u evaluaciji, a greška u pravilu znači ODBIJEN pristup — ne prelazak na
    // drugu granu ternara. Zato je fallback na users/{uid} bio mrtav kod: nalozi
    // napravljeni prije uvođenja uloga nisu mogli pročitati NIŠTA, jer je izraz
    // pukao prije nego što je do fallbacka uopšte došlo. Simptom je bio
    // "Missing or insufficient permissions" na organizations/{orgId} i beskonačno
    // učitavanje aplikacije.
    function hasClaim(name) {
      return request.auth != null
             && request.auth.token != null
             && request.auth.token.keys().hasAny([name]);
    }

    // Profil korisnika kao fallback izvor. `exists()` je nužan iz istog razloga:
    // `get()` na nepostojeći dokument vraća null, pa bi `.data.X` bila greška.
    // Ponovljeni `get()` na isti dokument u istoj evaluaciji je jedno čitanje.
    function profileData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function profileHas(field) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && profileData().keys().hasAny([field]);
    }

    // Organizacija korisnika.
    //
    // PRVENSTVO IMA CUSTOM CLAIM (`request.auth.token.orgId`), koji upisuje admin
    // SDK pri kreiranju naloga. Razlog nije samo brzina: `get()` na users/{uid} je
    // NAPLAĆENO ČITANJE pri svakoj evaluaciji pravila, a uz 2000 firmi to je
    // najveća pojedinačna stavka na računu.
    //
    // Fallback na Firestore postoji za naloge napravljene prije uvođenja claimova.
    // Njih AuthContext šalje na /api/auth/sync-claims pri prvoj prijavi, pa se
    // fallback s vremenom prestane koristiti.
    //
    // POLJE JE `Organization_ID` (vidi lib/auth.ts). Ranije je ovdje stajalo
    // `organizationId`, pa je helper vraćao null i SVAKO pravilo koje se na njega
    // oslanja odbijalo pristup.
    function getUserOrgId() {
      return hasClaim('orgId')
        ? request.auth.token.orgId
        : (profileHas('Organization_ID') ? profileData().Organization_ID : null);
    }

    function userRole() {
      return hasClaim('role')
        ? request.auth.token.role
        : (profileHas('Role') ? profileData().Role : null);
    }

    // STAFF = uloge koje smiju direktno u bazu (puna aplikacija).
    // Kontrolor i radnik NISU ovdje: njihov telefon ne dodiruje Firestore nego
    // ide kroz /api/field/home, koji vraća projekciju bez ijednog iznosa.
    // Razlog: pravila umiju zabraniti DOKUMENT, ali ne i POLJE — a work_orders
    // nosi Total_Value, Profit i Material_Cost.
    function isStaff() {
      return isAuthenticated() && userRole() in ['owner', 'admin', 'manager'];
    }

    // ISKLJUČIVO iz claima — namjerno BEZ fallbacka na Firestore. Claim postavlja
    // /api/auth/sync-claims čitajući users/{uid}.Is_Super_Admin, a to polje se od
    // sada ne može upisati s klijenta (vidi match /users). Time se lanac zatvara:
    // super admin se ne može sam sebi proglasiti.
    function isSuperAdmin() {
      return isAuthenticated() && hasClaim('superAdmin') && request.auth.token.superAdmin == true;
    }

    // Check if user belongs to the document's organization
    function isOrgMember() {
      return isStaff() &&
             resource.data.Organization_ID == getUserOrgId();
    }

    // Check if new document has correct organization ID
    function hasValidOrgId() {
      return isStaff() &&
             request.resource.data.Organization_ID == getUserOrgId();
    }

    // Skup polja koje mijenja ovaj zahtjev (radi i uz merge:true).
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ============================================
    // ORGANIZATIONS
    // ============================================
    
    match /organizations/{orgId} {
      // Čitanje: svaki član, uključujući pogonske uloge — AuthContext treba naziv
      // firme i aktivni paket. Dokument ne nosi podatke o klijentima ni cijene.
      // Super admin čita sve (konzola /admin nabraja organizacije).
      allow read: if isSuperAdmin() || (isAuthenticated() && getUserOrgId() == orgId);

      // SAMOREGISTRACIJA: signUp (lib/auth.ts) piše organizaciju i korisnika u
      // jednom batchu. Pravila svaki upis u batchu ocjenjuju protiv stanja PRIJE
      // batcha — users/{uid} tada još ne postoji, pa getUserOrgId() nema šta
      // pročitati i create bi bio odbijen. Zato create ide po determinističkom
      // ključu `<uid>_org`: korisnik može napraviti isključivo VLASTITU firmu.
      allow create: if isAuthenticated()
                    && orgId == request.auth.uid + '_org'
                    && request.resource.data.Organization_ID == orgId;

      // Paket, moduli i broj mjesta se PLAĆAJU — mijenja ih samo super admin
      // (konzola /admin). Bez ovoga bi svaki član firme sam sebi otključao
      // plaćene module jednim pozivom iz konzole browsera.
      allow update: if isSuperAdmin()
                    || (isStaff()
                        && getUserOrgId() == orgId
                        && !changedKeys().hasAny(['Subscription_Plan', 'Modules', 'Is_Active', 'Seat_Limit']));

      allow delete: if false;
    }

    // ============================================
    // USERS
    // ============================================

    match /users/{userId} {
      // Users can read their own profile
      // OR users in the same organization (for worker lists, user pickers, etc.)
      allow read: if isSuperAdmin() || isOwner(userId) ||
                     (isAuthenticated() &&
                      get(/databases/$(database)/documents/users/$(userId)).data.Organization_ID == getUserOrgId());

      // Samoregistracija vlasnika — isti razlog i isti ključ kao gore.
      // Is_Super_Admin se postavlja SAMO kroz Firestore konzolu.
      allow create: if isOwner(userId)
                    && request.resource.data.Organization_ID == request.auth.uid + '_org'
                    && request.resource.data.Role == 'owner'
                    && request.resource.data.Is_Super_Admin != true;

      // SRŽ MODELA ULOGA: korisnik smije mijenjati samo bezopasna polja svog
      // dokumenta. Prije ove izmjene je `allow write: if isOwner(userId)`
      // dozvoljavalo radniku da sam sebi upiše Role:'owner' i preuzme firmu.
      // Role, Organization_ID, Worker_ID, Is_Active i Is_Super_Admin piše
      // isključivo admin SDK kroz /api/team/*.
      allow update: if isOwner(userId)
                    && changedKeys().hasOnly(['Name', 'Phone', 'Last_Login']);

      allow delete: if false;   // nalozi se deaktiviraju, ne brišu (istorija rada)
    }
    
    // ============================================
    // PROJECTS (Multi-tenancy enabled)
    // ============================================
    
    match /projects/{projectId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }
    
    // ============================================
    // PRODUCTS (Multi-tenancy enabled)
    // ============================================
    
    match /products/{productId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }
    
    // ============================================
    // PRODUCT MATERIALS (Multi-tenancy enabled)
    // ============================================
    
    match /product_materials/{materialId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }
    
    // ============================================
    // MATERIALS CATALOG (Multi-tenancy enabled)
    // ============================================
    
    match /materials/{materialId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }
    
    // ============================================
    // GLASS ITEMS (Multi-tenancy enabled)
    // ============================================
    
    match /glass_items/{glassId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }
    
    // ============================================
    // ALU DOOR ITEMS (Multi-tenancy enabled)
    // ============================================
    
    match /alu_door_items/{doorId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }
    
    // ============================================
    // OFFERS (Multi-tenancy enabled)
    // ============================================
    
    match /offers/{offerId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }
    
    // ============================================
    // OFFER PRODUCTS (Multi-tenancy enabled)
    // ============================================
    
    match /offer_products/{offerProductId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }
    
    // ============================================
    // OFFER EXTRAS (Multi-tenancy enabled)
    // ============================================
    
    match /offer_extras/{extraId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }
    
    // ============================================
    // ORDERS (Multi-tenancy enabled)
    // ============================================
    
    match /orders/{orderId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }
    
    // ============================================
    // ORDER ITEMS (Multi-tenancy enabled)
    // ============================================
    
    match /order_items/{itemId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }
    
    // ============================================
    // SUPPLIERS (Multi-tenancy enabled)
    // ============================================
    
    match /suppliers/{supplierId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }
    
    // ============================================
    // WORKERS (Multi-tenancy enabled)
    // ============================================
    
    match /workers/{workerId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }
    
    // ============================================
    // WORKER ATTENDANCE (Multi-tenancy enabled)
    // ============================================
    
    match /worker_attendance/{attendanceId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }
    
    // ============================================
    // WORK ORDERS (Multi-tenancy enabled)
    // ============================================
    
    match /work_orders/{workOrderId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }
    
    // ============================================
    // WORK ORDER ITEMS (Multi-tenancy enabled)
    // ============================================
    
    match /work_order_items/{itemId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }
    
    // ============================================
    // WORK LOGS (Multi-tenancy enabled)
    // ============================================
    
    match /work_logs/{logId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }
    
    // ============================================
    // NOTIFICATIONS (Multi-tenancy enabled)
    // ============================================
    
    // PAŽNJA: notifications koriste `organizationId` (camelCase), NE `Organization_ID`
    // kao ostatak baze — vidi notificationService.ts. Zato ne mogu koristiti
    // isOrgMember()/hasValidOrgId().
    match /notifications/{notificationId} {
      allow read: if isStaff() && resource.data.organizationId == getUserOrgId();
      allow create: if isStaff() && request.resource.data.organizationId == getUserOrgId();
      allow update, delete: if isStaff() && resource.data.organizationId == getUserOrgId();
    }
    
    // ============================================
    // TASKS (Multi-tenancy enabled)
    // ============================================
    
    match /tasks/{taskId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }

    // ============================================
    // PROCESI: templejti toka, katalog, pravila materijal→proces
    // ============================================

    match /process_flow_templates/{templateId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }

    match /process_catalog/{itemId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }

    match /process_material_rules/{ruleId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }

    match /process_stage_templates/{templateId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }

    // ============================================
    // PRODUCTION SNAPSHOTS (finalni P&L pri završetku naloga)
    // ============================================

    match /production_snapshots/{snapshotId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }

    // ============================================
    // PLANNING SCENARIOS (Platno — pješčanik za planiranje)
    // Jedina kolekcija u koju platno piše. Bez ovog bloka čitanje je ODBIJENO
    // (rules nemaju catch-all match) i platno tiho ne radi.
    // ============================================

    match /planning_scenarios/{scenarioId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }

    // ============================================
    // ORG SETTINGS
    // ID DOKUMENTA je organizationId — dokument NEMA polje Organization_ID,
    // pa isOrgMember() ovdje ne radi. Veže se po ključu.
    // ============================================

    match /org_settings/{orgId} {
      allow read, write: if isStaff() && orgId == getUserOrgId();
    }

    // ============================================
    // HOLIDAYS (praznici)
    // Globalna kolekcija — upit u productivity.ts filtrira SAMO po datumu,
    // bez Organization_ID. Zato čitanje ostaje otvoreno svakom prijavljenom.
    //
    // PISANJE JE BILO OTVORENO SVIMA: bilo koja firma je mogla mijenjati ili
    // brisati praznike svim ostalima, a praznici ulaze u obračun radnih dana i
    // rokova. Sada piše samo staff, i samo dokumente svoje organizacije
    // (postojeći dokumenti bez Organization_ID ostaju samo za čitanje).
    // ============================================

    match /holidays/{holidayId} {
      allow read: if isAuthenticated();
      allow create: if isStaff() && request.resource.data.Organization_ID == getUserOrgId();
      allow update, delete: if isStaff() && resource.data.Organization_ID == getUserOrgId();
    }

    // ============================================
    // TASK PROFILES / MATERIAL TEMPLATES /
    // SERVICE DEFINITIONS / DAILY PROFIT ENTRIES
    // Standardni multi-tenancy obrazac (Organization_ID na dokumentu).
    // ============================================

    match /task_profiles/{profileId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }

    match /material_templates/{templateId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }

    match /service_definitions/{serviceId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }

    match /daily_profit_entries/{entryId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }

    // ============================================
    // ZAVRŠNI RAČUNI (Multi-tenancy enabled)
    // ============================================

    match /invoices/{invoiceId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }

    match /invoice_items/{invoiceItemId} {
      allow read: if isOrgMember();
      allow create: if hasValidOrgId();
      allow update, delete: if isOrgMember();
    }
  }
}
